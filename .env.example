# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública (publishable "sb_publishable_..." o la anon legacy). Nunca la service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-publishable-key
# URL pública del sitio (enlaces de compartir, Open Graph y redirecciones de Auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secreto para POST /api/revalidate (el panel o un webhook de la base lo usan para refrescar la caché).
# Genera uno largo y aleatorio, p. ej.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=
# Cloudflare Turnstile (captcha). Sin estas variables el captcha se omite (desarrollo).
# Claves de prueba que siempre pasan: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# El mismo secret va en Supabase > Authentication > Attack Protection > Captcha (Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
