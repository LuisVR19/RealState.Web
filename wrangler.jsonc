{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "realstate-web",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Workers Logs: guarda console.* e invocaciones para buscarlos en el dashboard
	// (Workers & Pages → realstate-web → Observability). Plan gratis: 200k eventos/día, 3 días.
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Se referencia a sí mismo; el nombre del servicio tiene que ser igual al "name" del Worker.
			// https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "realstate-web"
		}
	],
	"images": {
		// Optimización de imágenes de next/image: https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Límite de frecuencia por IP para las solicitudes de visita (lib/abuse.ts). Workers Rate Limiting:
	// period solo admite 10 o 60 s y el conteo es por ubicación de Cloudflare (aproximado); el límite
	// exacto por teléfono lo aplica la base en request_visit. namespace_id es único por cuenta.
	"ratelimits": [
		{
			"name": "VISIT_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			// Medición anónima de uso (app/api/track): cada llamada trae un lote de hasta 20 eventos.
			"name": "TRACK_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 60, "period": 60 }
		}
	],
	// --- Caché (ver open-next.config.ts y docs/DEPLOY-CLOUDFLARE.md) ---
	// Caché incremental en KV (gratis, sin tarjeta). Crea el namespace con
	// `npx wrangler kv namespace create isf-web-cache` y pega aquí el id.
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "06d78dba964d4bfd9e78576eba45e69c"
		}
	],
	// Caché de tags: crea la base con `npx wrangler d1 create isf-web-tag-cache` y pega aquí el id.
	"d1_databases": [
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "isf-web-tag-cache",
			"database_id": "d7d70f19-571b-47a3-aab4-db849f906ac3"
		}
	],
	// Cola de revalidación (Durable Object con SQLite, entra en el plan gratis).
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DOQueueHandler"]
		}
	]
}
